# Copie para secrets.env (ignorado pelo Git) e preencha com valores próprios.
# O kustomize transforma este arquivo no Secret "agenda-secrets".
POSTGRES_USER=agenda
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=agenda
DATABASE_URL=postgresql://agenda:troque-esta-senha@postgres:5432/agenda
RABBITMQ_DEFAULT_USER=agenda
RABBITMQ_DEFAULT_PASS=troque-esta-senha
RABBITMQ_URL=amqp://agenda:troque-esta-senha@rabbitmq:5672
JWT_SECRET=gere-um-valor-longo-e-aleatorio
ADMIN_EMAIL=admin@agenda.local
ADMIN_PASSWORD=troque-esta-senha
