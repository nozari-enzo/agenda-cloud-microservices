# Copie para .env (ignorado pelo Git) e troque TODOS os valores antes de subir:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Linux/macOS)
# O docker compose não sobe se alguma variável estiver faltando.
POSTGRES_USER=agenda
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=agenda
RABBITMQ_USER=agenda
RABBITMQ_PASSWORD=troque-esta-senha
# Valor longo e aleatório, por exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=gere-um-valor-longo-e-aleatorio
# Conta de administrador criada automaticamente na aplicação
ADMIN_EMAIL=admin@agenda.local
ADMIN_PASSWORD=troque-esta-senha
GRAFANA_USER=admin
GRAFANA_PASSWORD=troque-esta-senha
